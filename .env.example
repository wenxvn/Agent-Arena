# Ollama 本地原生 API。不需要 API Key；思考模式由项目固定关闭。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 可选：OpenAI-compatible 远程中转站。只在本机 .env 中填写真实密钥，绝不提交该文件。
AGENT_ARENA_PROVIDER=openai
AGENT_ARENA_MEMORY_VERSION=v2
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://example.com/v1
OPENAI_MODEL=gpt-5.6-terra
# OpenCode Go 网关要求稳定的会话头，用于路由与 prompt 缓存；多局 benchmark 可共用一个固定值。
OPENAI_SESSION_ID=agent-arena
# 严格 JSON Schema 模式：Zen 等网关支持时启用（默认 json_object 兼容性更广，Hiyo 曾拒绝 json_schema）。
# AGENT_ARENA_RESPONSE_FORMAT=json_schema

# V11 网页平台（可选）。默认运行目录为 runs/web；总预算只在真实模式生效。
# AGENT_ARENA_WEB_RUNS_DIR=runs/web
# AGENT_ARENA_WEB_TOTAL_BUDGET_CNY=3.00
