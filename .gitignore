# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration
.env
.env.*
!.env.example

# Generated experiment output
# runs/ and logs/ stay local (raw traces are large and contain machine paths;
#   see docs/v14/stage2-closure.md for the accepted audit gap).
# results/ IS tracked: it holds benchmark aggregates (benchmark_v3 /
#   evaluation_v2 JSON+CSV) that back the numbers quoted in docs/.
runs/
logs/

# Runtime junk that must never be committed even inside results/
*.lock

# Editor and OS files
.DS_Store
.idea/
.vscode/

# Pi/Ralph local loop state
.ralph/
.v14tmp/
