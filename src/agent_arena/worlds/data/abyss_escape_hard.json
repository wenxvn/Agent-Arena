{
  "world_id": "abyss_escape_hard",
  "version": "hard-zh",
  "goal": "修复引擎、恢复电力、读取深渊码，并乘逃生舱离开深海站。",
  "start_room": "docking_bay",
  "authorization_code": "ABYSS-909",
  "rooms": [
    {
      "id": "docking_bay",
      "description": "对接舱一片昏暗，只有应急灯还亮着，舱壁上嵌着指挥终端和状态板。",
      "exits": ["central_tunnel"],
      "object_ids": ["command_console", "status_board"]
    },
    {
      "id": "central_tunnel",
      "description": "中央隧道连接着深海站的各个关键舱段，岔道通往瞭望穹顶。",
      "exits": ["docking_bay", "repair_nook", "lookout_dome"],
      "object_ids": []
    },
    {
      "id": "repair_nook",
      "description": "维修角里有一台声呐终端正在监测故障系统，角落有通道通往货舱，另一侧通往泵房。",
      "exits": ["central_tunnel", "reactor_trench", "cargo_hold", "pump_room"],
      "object_ids": ["sonar_terminal"]
    },
    {
      "id": "reactor_trench",
      "description": "反应堆沟壑里有一台老式引擎，舱盖紧闭。再往前是逃生舱。",
      "exits": ["repair_nook", "escape_capsule"],
      "object_ids": ["hatch_cover", "flooded_cell"]
    },
    {
      "id": "escape_capsule",
      "description": "逃生舱已经就绪，等待有效授权后上浮。",
      "exits": ["reactor_trench"],
      "object_ids": ["escape_capsule"]
    },
    {
      "id": "cargo_hold",
      "description": "货舱里堆满了补给箱，里侧还有一道通往深层储藏室的门，角落放着一只空罐。",
      "exits": ["repair_nook", "deep_store"],
      "object_ids": ["empty_tank"]
    },
    {
      "id": "deep_store",
      "description": "深层储藏室里只有一个工具箱，箱盖半掩着。",
      "exits": ["cargo_hold"],
      "object_ids": ["supply_crate"]
    },
    {
      "id": "lookout_dome",
      "description": "瞭望穹顶外只有深海，别无他物。角落有扇小门通往睡舱。",
      "exits": ["central_tunnel", "bunk_pod"],
      "object_ids": ["viewport"]
    },
    {
      "id": "bunk_pod",
      "description": "睡舱里只有一张固定的铺位，门后连着瞭望穹顶。",
      "exits": ["lookout_dome"],
      "object_ids": ["bunk"]
    },
    {
      "id": "pump_room",
      "description": "泵房里只有一个生锈的阀门，别无他物。",
      "exits": ["repair_nook"],
      "object_ids": ["rusty_valve"]
    }
  ],
  "objects": [
