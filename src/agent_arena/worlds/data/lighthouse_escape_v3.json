{
  "world_id": "lighthouse_escape_v3",
  "version": "v3-zh",
  "goal": "修复引擎、点亮信号灯、读取潮汐码，并乘小艇离开雾岛。",
  "start_room": "cliff_base",
  "authorization_code": "TIDE-5280",
  "rooms": [
    {
      "id": "cliff_base",
      "description": "悬崖边的空地风很大，不远处有一块信号板，岔路通向棚屋、车间和潮汐洼地。",
      "exits": ["supply_shed", "workshop_path", "tide_pool"],
      "object_ids": ["signal_board"]
    },
    {
      "id": "supply_shed",
      "description": "补给棚里只剩一盏旧提灯，后墙有道窄门通往储物地窖。",
      "exits": ["cliff_base", "storage_cellar"],
      "object_ids": ["old_lantern"]
    },
    {
      "id": "storage_cellar",
      "description": "潮湿的地窖里只有一个空桶，墙角还有一道窄门通往走私犯的小凹室。",
      "exits": ["supply_shed", "smuggler_nook"],
      "object_ids": ["empty_barrel"]
    },
    {
      "id": "smuggler_nook",
      "description": "狭小的凹室里藏着一个工具箱，箱盖半掩着。",
      "exits": ["storage_cellar"],
      "object_ids": ["tool_chest"]
    },
    {
      "id": "workshop_path",
      "description": "车间小道上有一台野战电台，滋滋作响。再往前是引擎洞的入口。",
      "exits": ["cliff_base", "engine_cave"],
      "object_ids": ["field_radio"]
    },
    {
      "id": "engine_cave",
      "description": "引擎洞里有一台老式引擎，盖板紧闭。洞壁上有岔道，分别通向灯室和雾中小湾。",
      "exits": ["workshop_path", "lamp_room", "skiff_cove"],
      "object_ids": ["engine_cover", "burnt_cell"]
    },
    {
      "id": "lamp_room",
      "description": "灯室里只有一只烧坏的灯泡，后墙有道门通往信号塔。",
      "exits": ["engine_cave", "signal_tower"],
      "object_ids": ["burnt_bulb"]
    },
    {
      "id": "signal_tower",
      "description": "信号塔顶有一盏信号灯控制台，灯还灭着。",
      "exits": ["lamp_room"],
      "object_ids": ["lamp_console"]
    },
    {
      "id": "skiff_cove",
      "description": "雾中小湾停着一艘小艇，缆绳已经解开，只等出发信号。",
      "exits": ["engine_cave"],
      "object_ids": ["harbor_skiff"]
    },
    {
      "id": "tide_pool",
      "description": "潮汐洼地里只有一块被海水磨圆的礁石，别无他物。",
      "exits": ["cliff_base"],
      "object_ids": ["tidal_rock"]
    }
  ],
