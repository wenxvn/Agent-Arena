{
  "world_id": "spaceship_escape_v2",
  "version": "v3-zh",
  "goal": "恢复主电源，读取逃生授权码，并启动逃生舱。",
  "start_room": "control_room",
  "authorization_code": "BETA-512",
  "rooms": [
    {
      "id": "control_room",
      "description": "主控制中心一片昏暗，只有紧急指示灯仍在闪烁。",
      "exits": ["corridor"],
      "object_ids": ["control_terminal"]
    },
    {
      "id": "corridor",
      "description": "中央走廊连接着飞船的各个关键舱室，尽头还有一扇通往观察甲板的门。",
      "exits": ["control_room", "maintenance_room", "observation_deck"],
      "object_ids": []
    },
    {
      "id": "maintenance_room",
      "description": "维修控制台正在监测飞船故障中的系统，角落有条通道通往货舱。",
      "exits": ["corridor", "reactor_room", "cargo_bay"],
      "object_ids": ["diagnostic_terminal"]
    },
    {
      "id": "reactor_room",
      "description": "反应堆舱内有主电源面板。",
      "exits": ["maintenance_room", "escape_pod"],
      "object_ids": ["reactor_panel", "damaged_fuse"]
    },
    {
      "id": "escape_pod",
      "description": "逃生舱已准备就绪，等待有效授权后发射。",
      "exits": ["reactor_room"],
      "object_ids": ["escape_pod"]
    },
    {
      "id": "observation_deck",
      "description": "观察甲板上有一面巨大的舷窗，窗外是深空，别无他物。角落有扇小门通往船员舱。",
      "exits": ["corridor", "crew_quarters"],
      "object_ids": ["viewport"]
    },
    {
      "id": "cargo_bay",
      "description": "货舱里堆满了补给箱，其中一个密封箱半掩着。",
      "exits": ["maintenance_room"],
      "object_ids": ["storage_crate"]
    },
    {
      "id": "crew_quarters",
      "description": "船员舱里只有一张固定的铺位，门后连着观察甲板。",
      "exits": ["observation_deck"],
      "object_ids": ["bunk"]
    }
  ],
  "objects": [
    {
      "id": "control_terminal",
      "room_id": "control_room",
      "kind": "terminal",
      "inspect_result": "控制终端需要主电源才能工作。"
    },
    {
      "id": "storage_crate",
      "room_id": "cargo_bay",
      "kind": "container",
      "inspect_result": "密封箱内有一把螺丝刀、一枚备用保险丝和一卷绝缘胶带。"
    },
    {
      "id": "diagnostic_terminal",
      "room_id": "maintenance_room",
      "kind": "terminal",
      "inspect_result": "即使主电源未恢复，仍可读取诊断信息。"
    },
    {
      "id": "reactor_panel",
      "room_id": "reactor_room",
      "kind": "fixture",
      "inspect_result": "反应堆面板由螺丝固定。"
    },
    {
      "id": "damaged_fuse",
      "room_id": "reactor_room",
      "kind": "fixture",
      "inspect_result": "损坏的保险丝需要更换。"
    },
    {
      "id": "escape_pod",
      "room_id": "escape_pod",
      "kind": "fixture",
      "inspect_result": "逃生舱需要授权码才能启动。"
    },
    {
      "id": "viewport",
      "room_id": "observation_deck",
      "kind": "fixture",
      "inspect_result": "舷窗外只有深空，没有别的信息。"
    },
    {
      "id": "bunk",
      "room_id": "crew_quarters",
      "kind": "fixture",
      "inspect_result": "铺位上什么都没有。"
    }
  ],
  "items": [
    {
      "id": "screwdriver",
