{
  "world_id": "subway_escape_hard",
  "version": "hard-zh",
  "goal": "修复配电柜、恢复供电、读取调度码，并乘工程车离开地铁站。",
  "start_room": "concourse",
  "authorization_code": "METRO-783",
  "rooms": [
    {
      "id": "concourse",
